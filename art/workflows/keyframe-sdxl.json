{
  "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "SDXL base 1.0"},
        "inputs": {"ckpt_name": "sdxl-full/sd_xl_base_1.0.safetensors"}},
  "2": {"class_type": "CLIPTextEncode", "_meta": {"title": "$prompt"},
        "inputs": {"clip": ["1", 1], "text": "cute cartoon illustration"}},
  "3": {"class_type": "CLIPTextEncode", "_meta": {"title": "$negative_prompt"},
        "inputs": {"clip": ["1", 1], "text": "scary, realistic"}},
  "4": {"class_type": "EmptyLatentImage", "_meta": {"title": "1024x1024 latent"},
        "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "5": {"class_type": "KSampler", "_meta": {"title": "$seed"},
        "inputs": {"model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0],
                   "seed": 7, "steps": 28, "cfg": 6.5, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0}},
  "6": {"class_type": "VAEDecode", "_meta": {"title": "decode"},
        "inputs": {"samples": ["5", 0], "vae": ["1", 2]}},
  "7": {"class_type": "SaveImage", "_meta": {"title": "save keyframe"},
        "inputs": {"images": ["6", 0], "filename_prefix": "macron-anim/keyframe"}}
}
