{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "Qwen-Image-Edit-2511 (fp8)"},
        "inputs": {"unet_name": "qwen_image_edit_2511_fp8mixed.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "_meta": {"title": "Qwen2.5-VL text encoder"},
        "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "Qwen-Image VAE"},
        "inputs": {"vae_name": "qwen_image_vae.safetensors"}},
  "4": {"class_type": "LoraLoaderModelOnly", "_meta": {"title": "Lightning 4-step LoRA"},
        "inputs": {"model": ["1", 0], "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors", "strength_model": 1.0}},
  "5": {"class_type": "ModelSamplingAuraFlow", "_meta": {"title": "shift"},
        "inputs": {"model": ["4", 0], "shift": 3.0}},
  "6": {"class_type": "LoadImage", "_meta": {"title": "reference image"},
        "inputs": {"image": "$init_image"}},
  "7": {"class_type": "ImageScaleToTotalPixels", "_meta": {"title": "~1 megapixel"},
        "inputs": {"image": ["6", 0], "upscale_method": "lanczos", "megapixels": 1.0, "resolution_steps": 16}},
  "8": {"class_type": "TextEncodeQwenImageEditPlus", "_meta": {"title": "$prompt"},
        "inputs": {"clip": ["2", 0], "vae": ["3", 0], "image1": ["7", 0], "prompt": "keep the characters exactly the same"}},
  "9": {"class_type": "TextEncodeQwenImageEditPlus", "_meta": {"title": "$negative_prompt"},
        "inputs": {"clip": ["2", 0], "vae": ["3", 0], "image1": ["7", 0], "prompt": ""}},
  "10": {"class_type": "VAEEncode", "_meta": {"title": "encode reference"},
         "inputs": {"pixels": ["7", 0], "vae": ["3", 0]}},
  "11": {"class_type": "KSampler", "_meta": {"title": "$seed"},
         "inputs": {"model": ["5", 0], "positive": ["8", 0], "negative": ["9", 0], "latent_image": ["10", 0],
                    "seed": 11, "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "12": {"class_type": "VAEDecode", "_meta": {"title": "decode"},
         "inputs": {"samples": ["11", 0], "vae": ["3", 0]}},
  "13": {"class_type": "SaveImage", "_meta": {"title": "save edit"},
         "inputs": {"images": ["12", 0], "filename_prefix": "macron-anim/edit"}}
}
